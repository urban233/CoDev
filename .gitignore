__pycache__/
*.py[cod]
*.egg-info/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/
.idea
.DS_Store

# Bazel output symlinks and repo-local tool binaries (see
# docs/features/bazel-migration/design.md) -- never committed. Anchored to
# the repo root so this doesn't also match docs/features/bazel-migration/.
/bazel-*
.tools/
.bazelbsp

# Local escalation log (ADR-0003) -- deliberately not shared/committed, this
# project's own dogfood usage of `codev work`.
.codev/work/escalations.jsonl

real-use-cases

# codev:start
# CoDev local escalation log (ADR-0003) -- not shared or committed.
.codev/task/escalations.jsonl
# CoDev local hook state -- decision log, refusal counters, anything a hook
# writes to remember itself between firings. None of it is shared or
# committed. The whole directory rather than one filename, because each new
# hook otherwise has to remember to add its own line and the first one to
# forget gets swept into the change under review by `codev git commit`'s
# `git add -A`. Globbed rather than root-anchored: a hook invoked with a
# working directory below the repository root writes there instead.
**/.codev/hooks/
# Pull-request data the review skills fetch -- a cache of GitHub's answers,
# rebuilt on demand. Without this, `codev git commit`'s `git add -A` sweeps
# thousands of lines of API responses into the change under review.
.codev/pr-review/
# A task's tracked state is round-state.json and git-state.json. Everything
# else an agent writes under a task's directory is a review payload it rebuilds
# on demand -- findings, coverage, specialist selections, triage -- and a
# `git add -A` would otherwise sweep it into the change under review.
.codev/task/*/*
!.codev/task/*/round-state.json
!.codev/task/*/git-state.json
# codev:end
