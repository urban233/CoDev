+    """What one `task.check` outcome implies. A record rather than a tuple
+    because the fifth field arrived and unpacking four-tuples in a dozen
+    places is how a fifth field gets skipped."""
+
+    recommendation: str
+    reason: str
+    command: str | None
+    blocked: bool
+    options: tuple[Option, ...] = ()
