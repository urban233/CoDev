"""Ruff and mypy runnable targets. See docs/features/bazel-migration/design.md."""

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Referenced by //packaging:wheel (description_file, extra_distinfo_files).
exports_files(["README.md", "LICENSE"])

# This repository's own always-on Claude Code instruction payload -- the
# root checkout's live files, not their bundle/*.py.template counterparts,
# since it is *this* session's payload //tests:test_instruction_budget
# measures. Referenced there rather than through the codev_workflow
# package's own `bundle/**` data, which mirrors this content for every
# repository CoDev installs into, not just this one's.
filegroup(
    name = "instruction_budget_sources",
    srcs = [
        "AGENTS.md",
        ".claude/CLAUDE.md",
        ".codev/for-ai/ai-agent-guidelines.md",
        ".codev/instruction-budget-baseline.json",
    ] + glob([
        ".claude/skills/*/SKILL.md",
        ".claude/agents/*.md",
    ]),
    visibility = ["//tests:__pkg__"],
)

# ruff ships a compiled native executable, not a console_scripts entry
# point, so py_console_script_binary cannot wrap it -- see design.md's
# "Tooling Integration" section.
native_binary(
    name = "ruff_bin_native",
    src = "@pip//ruff:data",
    out = "ruff_bin",
)

py_console_script_binary(
    name = "mypy_bin",
    pkg = "@pip//mypy",
    script = "mypy",
)

# bazel run executes with cwd set to the target's runfiles directory, not
# the invocation directory, so both tools need a BUILD_WORKSPACE_DIRECTORY
# wrapper to behave like their `python -m` equivalents.
sh_binary(
    name = "ruff",
    srcs = ["tools/ruff.sh"],
    data = [":ruff_bin_native"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "mypy",
    srcs = ["tools/mypy.sh"],
    data = [":mypy_bin"],
    visibility = ["//visibility:public"],
)
