{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(codev next:*)",
      "Bash(codev task check:*)",
      "Bash(codev task log:*)",
      "Bash(just test)",
      "Bash(just lint)",
      "Bash(just typecheck)",
      "Bash(just fmt-check)",
      "Bash(just validate-catalog)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(just publish-pypi:*)",
      "Bash(just publish-testpypi:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require_plan.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require_wave_shape.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require_small_change.py\""
          }
        ]
      }
    ]
  }
}
