load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Shared support for the integration tier -- a real repository, a real bare
# remote, and a `gh` stubbed at the process boundary. Not a test itself, so
# it is a library every test target can depend on rather than a src.
py_library(
    name = "integration_support",
    srcs = ["integration_support.py", "__init__.py"],
    imports = [".."],
)

[
    py_test(
        name = test_file.removesuffix(".py"),
        srcs = [test_file],
        # Recorded baselines a test reads at runtime -- currently
        # navigator-coverage-baseline.json. Without this the file is absent
        # from the sandbox and the test fails on a missing path rather than
        # on the thing it measures.
        data = glob(["*.json"], allow_empty = True),
        deps = [
            "//src/codev_workflow:codev_workflow",
            "//scripts:scripts",
            ":integration_support",
        ],
    )
    for test_file in glob(["test_*.py"])
]
